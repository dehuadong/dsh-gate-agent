{
  "tools": [
    {
      "name": "gate_start_phase",
      "description": "在用户明确授权后从 discuss/complete 进入 plan 或 implement。仅 root agent 可调用；授权可以在对话中要求用户再输入 slash command或 ask_user_question 中给出。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string",
            "enum": [
              "plan",
              "implement"
            ]
          },
          "brief": {
            "type": "string"
          }
        },
        "required": [
          "node"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_record",
      "description": "记录 root agent 派发的节点 worker 结果并推进 gate 状态。worker 节点要求 workerSessionIds；review 节点要求两轴结果；verify 要求 toolResults。仅 root agent 可调用。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "node": {
            "type": "string",
            "enum": [
              "plan",
              "plan-review",
              "proposal-review",
              "plan-revise",
              "implement",
              "code-review",
              "implement-revise",
              "verify",
              "verify-standalone",
              "note-lifecycle",
              "docs",
              "code-review-standalone",
              "fix-bug"
            ]
          },
          "workerSessionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reviewAxes": {
            "type": "object",
            "additionalProperties": true
          },
          "task": {
            "type": "string"
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "requiresDiscussion": {
            "type": "boolean"
          },
          "discussionReason": {
            "type": "string"
          },
          "notePaths": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "description": "接受 .agents/notes/<lifecycle>/<class>/...、<lifecycle>/<class>/... 或 <class>/...；state 归一为完整路径。"
                },
                "class": {
                  "type": "string",
                  "enum": [
                    "feature",
                    "bug-fix",
                    "simplification",
                    "architecture",
                    "process",
                    "testing"
                  ]
                },
                "lifecycle": {
                  "type": "string",
                  "enum": [
                    "proposed",
                    "implemented"
                  ]
                }
              },
              "required": [
                "path",
                "class",
                "lifecycle"
              ]
            }
          },
          "noteDecision": {
            "type": "string",
            "enum": [
              "new",
              "update",
              "in-place",
              "mechanical"
            ]
          },
          "noteSearch": {
            "type": "string"
          },
          "verification": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "commands": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "gate workspace 内普通文件路径。"
                }
              },
              "toolResults": {
                "type": "array",
                "items": {
                  "type": "string",
                  "description": "verify worker session log 中真实 tool/result 的 call_... id。"
                }
              },
              "passed": {
                "type": "boolean"
              }
            },
            "required": [
              "commands",
              "evidence",
              "toolResults",
              "passed"
            ]
          }
        },
        "required": [
          "node"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_status",
      "description": "读取 Gate 当前状态与当前 procedure（root）。只读；派发 worker 前、推进节点前、compaction 后、失败后恢复时使用。worker 调用返回 root 状态但不返回 root procedure。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_note_write",
      "description": "写 proposed Agent Note，或在 planning 原地更新已存在的 implemented Note。仅 planning worker；通用 write/edit/apply_patch 和仓库写被拒绝，只读 shell 可用。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "description": "相对 .agents/notes 的路径；proposed/ 可新建，implemented/ 只能编辑已存在文件。"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "path",
          "content"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_note_verify",
      "description": "运行内置 notes 校验；note-lifecycle 中通过后设置 noteVerified。root-only。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_note_finalize",
      "description": "把 note-lifecycle 中的 proposed Note 移到 implemented 并更新头块；root-only。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "decisionBodies": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "body"
              ]
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_help",
      "description": "只读列出 gate 命令、工具用途和当前 phase/node。仅 root agent；只在不确定命令名/工具用途时使用。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_artifact_write",
      "description": "按 .agents/gate/artifact-policy.json 写白名单 artifact（handoff/prd/research 等）。只写文件，不走普通 workspace write 权限。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "description": "policy 中的 artifact kind。"
          },
          "path": {
            "type": "string",
            "description": "workspace 内相对路径。"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "kind",
          "path",
          "content"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    },
    {
      "name": "gate_research_dispatch",
      "description": "root-only：在 discuss 或 orchestrating/plan 派 research worker，等待结果；worker 只能通过 artifact policy 写 research 文档。",
      "parameters": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "question": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "required": [
          "question"
        ]
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true
      }
    }
  ],
  "commands": [
    {
      "name": "gate-init",
      "description": "初始化 notes、AGENTS.md、verify-notes、CI、git 与基础 .gitignore",
      "input": null
    },
    {
      "name": "gate-enter-plan",
      "description": "基于讨论共识、既有决策与用户输入进入 planning",
      "input": {
        "hint": "<具体工作事项或上下文语义>"
      }
    },
    {
      "name": "gate-enter-implement",
      "description": "基于已确认计划或讨论后的实施说明进入 implementation",
      "input": {
        "hint": "<具体工作事项或上下文语义>"
      }
    },
    {
      "name": "gate-prd",
      "description": "在 discuss 中按用户要求创建或更新 PRD",
      "input": {
        "hint": "[主题或上下文语义]"
      }
    },
    {
      "name": "gate-fix-bug",
      "description": "为已授权缺陷派发 fix worker，基于描述或当前上下文修复",
      "input": {
        "hint": "<具体工作事项或上下文语义>"
      }
    },
    {
      "name": "gate-docs",
      "description": "进入文档治理，按项目文档规范处理",
      "input": {
        "hint": "[文档范围或上下文语义]"
      }
    },
    {
      "name": "gate-implement-review",
      "description": "对当前改动做独立只读 code review",
      "input": {
        "hint": "<具体工作事项或上下文语义>"
      }
    },
    {
      "name": "gate-code-verify",
      "description": "对当前改动做独立只读验收（gate-user-verify）",
      "input": {
        "hint": "<具体工作事项或上下文语义>"
      }
    },
    {
      "name": "gate-propose-review",
      "description": "对提案做独立只读三轴评审",
      "input": {
        "hint": "<具体工作事项或上下文语义>"
      }
    },
    {
      "name": "gate-block",
      "description": "手动暂停：保留当前节点并停止写入/派 worker；对话仍可继续",
      "input": {
        "hint": "[原因]"
      }
    },
    {
      "name": "gate-resume",
      "description": "解冻 blocked：回到 block 前的节点；轮次耗尽回 discuss",
      "input": null
    },
    {
      "name": "gate-return-discuss",
      "description": "放弃当前节点，回到 discuss",
      "input": null
    },
    {
      "name": "gate-status",
      "description": "查看当前 phase/node、procedure、access 与下一步命令",
      "input": null
    },
    {
      "name": "gate-note-verify",
      "description": "只读检查 notes tree/format/lifecycle/archived",
      "input": null
    },
    {
      "name": "gate-note-archive",
      "description": "将 implemented Note 归档到 archived/：加 Archived、移动、封印并报告入站链接",
      "input": {
        "hint": "<implemented-note> [--superseded-by <new-note>]"
      }
    },
    {
      "name": "gate-note-board",
      "description": "生成决策看板 board.html（轻量模式，连接本地 notes 目录）",
      "input": {
        "hint": "[输出路径] [标题]"
      }
    },
    {
      "name": "gate-note-seal",
      "description": "只给 archived/ 中已有 Note 补写 manifest.json 的 SHA-256 封印；不归档、不改 Note 内容",
      "input": null
    }
  ],
  "sections": [
    {
      "name": "gate:protocol",
      "order": 1
    }
  ],
  "guards": 1,
  "preSteps": [
    "agent/pre-step"
  ]
}
